# ============================================================
# 虚拟机内构建 - 配置模板（脱敏版）
#
# 用法：复制本文件为 config/vm.env 并填写你的实际环境值。
#       config/vm.env 已被 .gitignore 排除，不会提交到仓库。
#
# 本模板仅包含占位符，不含任何真实 IP / 用户名 / 密钥 / 主机名。
# ============================================================

# 连接方式：guest-agent（推荐，无需 SSH 与密钥）或 ssh
VM_CONNECT=guest-agent

# libvirt 连接 URI（guest-agent 模式使用）
VM_LIBVIRT_URI=qemu:///system

# 虚拟机名称（占位符，请改为你的 VM 名）
VM_NAME=tn3399-builder

# ---- 以下仅 VM_CONNECT=ssh 时需要 ----
# SSH 目标，格式 [user@]host；如使用 libvirt NAT，可留 host 为空由脚本从 virsh domifaddr 解析
VM_SSH_TARGET=user@192.0.2.10
VM_SSH_PORT=22
# SSH 私钥路径（占位符）。支持 ~ 展开；留空则使用 ssh 默认密钥。
VM_SSH_KEY=

# 虚拟机内项目根目录（绝对路径）；同步与构建都在此目录进行
VM_PROJECT_DIR=/home/user/tn3399

# 是否在构建前把宿主机项目文件（config/scripts/docs/Makefile）同步进 VM
# 1=同步（默认，适合首次或脚本有改动）；0=跳过（VM 内已有最新代码）
VM_SYNC_SOURCE=1

# 是否在构建完成后把 VM 的 output/ 回拷到宿主机 output/
# 1=回拷；0=不回拷（产物仅留在 VM）
VM_PULL_OUTPUT=1

# VM 内构建使用的 make 目标（由命令行参数覆盖，此处为默认值）
VM_MAKE_TARGET=all
