# TN3399_V3 定制固件项目 - 版本与路径配置
# 该文件同时被 Makefile(include) 与 shell 脚本(source) 使用，请保持 KEY=value 形式。

CROSS_COMPILE=aarch64-linux-gnu-

# ===== 国内下载加速 =====
# GitHub raw / codeload 统一走 gh-proxy（实测约 1.5 MB/s，直连约 24 KB/s）。
# 如需关闭代理，改成 USE_GH_PROXY=0；也可换成其他可用的代理前缀。
USE_GH_PROXY=1
GH_PROXY=https://gh-proxy.com

# 基础镜像：Armbian trixie minimal for RK3399 (NanoPi M4v2)
# USTC 的 armbian-dl 镜像对该文件返回 403，改用 Armbian 官方源（实测 200）。
ARMBIAN_BASE_URL=https://dl.armbian.com/nanopim4v2/archive/Armbian_26.8.1_Nanopim4v2_trixie_current_6.18.44_minimal.img.xz
ARMBIAN_BASE_SHA=a29bc296896681449cf353c30921158b531401cec905a67d44ef0b0423a7e3e9

# 上游源码版本（固定 commit/tag，避免漂移）
UBOOT_REPO=https://github.com/u-boot/u-boot.git
UBOOT_REF=v2026.01
UBOOT_COMMIT=127a42c7257a6ffbbd1575ed1cbaa8f5408a44b3
RKBIN_REPO=https://github.com/rockchip-linux/rkbin.git
RKBIN_COMMIT=3e288fe814e059dd06833495f845cab04ac20a5c
KERNEL_REPO=https://github.com/armbian/linux-rockchip.git
KERNEL_REF=rk-6.1-rkr7.2
KERNEL_COMMIT=02b126b94d8b88408b9230b32f4921b10ac421b3
MPP_REPO=https://github.com/rockchip-linux/mpp.git
MPP_REF=develop
MPP_COMMIT=9b56348cc61393c84662e6d6dd78feae67773a36

# Rockchip 启动 blob（来自 rkbin）
# TN3399_V3 板载 DDR3 为三星 K4B8G16（8Gb 颗粒），使用 800MHz 初始化 blob。
# v1.30 为当前 rkbin 自带版本（v1.24 已从新版 rkbin 移除，旧版备份在 firmware/）。
DDR_BLOB=bin/rk33/rk3399_ddr_800MHz_v1.30.bin
# BL31：使用当前 rkbin commit 中实际存在的版本。
BL31_BLOB=bin/rk33/rk3399_bl31_v1.36.elf
USB_LOADER=rk3399_loader_v1.30.130.bin

# DTB 名称：U-Boot / Armbian boot script / extlinux 必须完全一致
DTB_NAME=rk3399-tn3399-v3.dtb
FDT_FILE=rockchip/rk3399-tn3399-v3.dtb

# 串口
BAUDRATE=1500000
CONSOLE=ttyS2

# 固件下载源（retro98boy 的 TN3399_V3 仓库）
TN3399_FIRMWARE_BASE=https://raw.githubusercontent.com/retro98boy/tiannuo-tn3399-v3-linux/main
