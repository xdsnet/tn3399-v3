# TN3399_V3 硬件补充配置
# 追加到 armbian/linux-rockchip rk-6.1-rkr7.2 的 rockchip_linux_defconfig 之后。
# 注意：vendor BSP DTS 使用 Rockchip 的 wireless-* platdata 节点，
#       因此这里启用官方 bcmdhd 驱动，而不是 mainline brcmfmac，避免两个驱动争用 SDIO 设备。

# --- AP6255 WiFi (SDIO, BCM43455) ---
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
# CONFIG_CFG80211_WEXT is not set
CONFIG_BCMDHD=m
CONFIG_BCMDHD_SDIO=y
CONFIG_BCMDHD_OOB=y
CONFIG_BCMDHD_FW_PATH="/lib/firmware/brcm/fw_bcm43455c0_ag.bin"
CONFIG_BCMDHD_NVRAM_PATH="/lib/firmware/brcm/nvram_ap6255.txt"
# CONFIG_BCMDHD_PCIE is not set
# CONFIG_BCMDHD_USB is not set
# CONFIG_BRCMFMAC is not set

# --- AP6255 Bluetooth (UART, BCM4345C0) ---
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
# CONFIG_BT_HCIUART_ROCKCHIP is not set
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m

# --- RTL8211E 千兆 PHY ---
CONFIG_REALTEK_PHY=y

# --- JMS578 USB3.0 -> SATA 桥接 ---
CONFIG_USB_UAS=y
CONFIG_USB_STORAGE=y
CONFIG_SATA_AHCI=y

# --- MPP / dma-buf heap（vendor 6.1 已默认开启，显式固化防止被 olddefconfig 关闭） ---
CONFIG_ROCKCHIP_MPP_SERVICE=y
CONFIG_ROCKCHIP_MPP_RKVDEC=y
CONFIG_ROCKCHIP_MPP_VDPU1=y
CONFIG_ROCKCHIP_MPP_VDPU2=y
CONFIG_ROCKCHIP_MPP_VEPU1=y
CONFIG_ROCKCHIP_MPP_VEPU2=y
CONFIG_ROCKCHIP_MPP_OSAL=y
CONFIG_RK_DMABUF_DEBUG=y
